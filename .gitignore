# 依赖
node_modules/

# 构建中间产物
dist/
build/
*.tsbuildinfo

# 本地发布产物（可下载的 zip 挂在 GitHub Release 上，不入库）
release/

# 桌面端打包输出（产物归档在 release/）
desktop/release/
desktop/out/

# 桌面端图标：虽然是 make-icon.ps1 生成出来的，但它是**打包必需的输入**
# （母图在 docs/images/icon.png），所以单独放行 —— 跟 web/vendor/ 一个道理
!desktop/build/
!desktop/build/**

# 桌面端把 web/ 拷进来的暂存目录：web/ 才是真源，别提交两份
desktop/app/
desktop/node_modules/

# 安卓构建产物
android/.gradle/
android/build/
android/android/app/build/
android/android/build/
android/android/app/debug/
*.apk
*.keystore

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/*.log

# 注意：web/vendor/ 是「产物入库」的依赖包，故意不忽略
